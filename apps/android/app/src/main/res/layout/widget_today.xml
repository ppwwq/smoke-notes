<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Jotday" android:textSize="20sp" android:textStyle="bold" android:textColor="#332D39"/>
        <TextView android:id="@+id/widget_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#756486"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="8dp" android:paddingTop="4dp" android:textSize="10sp" android:textColor="#8B8176"/>
    <TextView android:id="@+id/widget_row1" style="@style/WidgetLine" android:text="今日待办与日程"/>
    <TextView android:id="@+id/widget_row2" style="@style/WidgetLine"/>
    <TextView android:id="@+id/widget_row3" style="@style/WidgetLine"/>
    <TextView android:id="@+id/widget_row4" style="@style/WidgetLine"/>
    <TextView android:id="@+id/widget_row5" style="@style/WidgetLine"/>
    <TextView android:id="@+id/widget_row6" style="@style/WidgetLine"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/widget_note" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:gravity="center" android:text="＋ 便签" android:textColor="#756486" android:textSize="14sp"/>
        <TextView android:id="@+id/widget_todo" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:gravity="center" android:text="＋ 待办" android:textColor="#756486" android:textSize="14sp"/>
    </LinearLayout>
</LinearLayout>
